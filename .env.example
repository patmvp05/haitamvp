# Supabase project URL. Settings → API in the Supabase dashboard, or printed by
# `npx supabase start` for local development.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"

# Service role key — SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_ and never
# import lib/supabase/server.ts from a Client Component; this key bypasses Row
# Level Security.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# Public anon key — currently unused because both the TV and staff dashboard
# access Supabase through server-only code.
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_ANON_KEY"

# Shown on the "can't reach hotel systems" and "room not found" screens when the
# hotel_settings row can't be loaded. Falls back to "the front desk" if unset.
NEXT_PUBLIC_FALLBACK_RECEPTION_PHONE="+84 28 1234 5678"

# Shared password for the small staff dashboard at /admin. Keep this server-only
# (never prefix it with NEXT_PUBLIC_) and choose a unique password.
STAFF_DASHBOARD_PASSWORD="REPLACE_WITH_A_STRONG_SHARED_PASSWORD"

# Random secret used to sign staff session cookies. Use at least 32 random
# characters and keep it separate from the shared password.
STAFF_SESSION_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
